# Local Compose configuration. Copy to .env and keep the real file uncommitted.

# Replace both values outside disposable local development.
JWT_SECRET=local-development-secret-change-me
INTERNAL_EVENT_SECRET=local-internal-event-secret-change-me

# Local PostgreSQL bootstrap account.
POSTGRES_ADMIN_PASSWORD=igot_admin

# Ordered AI providers. Empty keys are skipped and deterministic fallback remains available.
AI_PROVIDER_ORDER=groq,nim,gemini,openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NIM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# Local labs profile.
LAB_DEFAULT_TTL_MINUTES=60

# Local frontend quick-login learner. Disable this outside demo environments.
DEMO_ACCOUNTS_ENABLED=true
DEMO_LEARNER_EMAIL=rajesh.kumar@mospi.gov.in
DEMO_LEARNER_PASSWORD=Learner@123
DEMO_LEARNER_NAME=Rajesh Kumar
