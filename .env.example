# ========================================================
# iGOT Karmayogi: backend environment variables
# Copy to .env in the repository root. Never commit the real file.
# The frontend reads its own file, frontend/.env.local (see LOCAL_SETUP.md).
# ========================================================

# Database
# Supabase Postgres (team setup). If your network has no IPv6, use the Session pooler string from the dashboard.
# DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# Local SQLite (offline development): leave DATABASE_URL unset, or:
DATABASE_URL=sqlite:///./karmayogi.db

# Login token signing key: use any long random string
SECRET_KEY=change-me-to-a-long-random-string

# LLMs: tried in order Groq, then OpenAI, then Gemini. One working key is enough.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Personalised recommendations: vector search (embeddings use GOOGLE_API_KEY)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=igot-competency-recommendations

# Supabase project (optional, for the Supabase CLI and tools)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
