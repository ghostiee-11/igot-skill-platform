{
  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "context": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          },
          "message": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "AgentRequest",
        "type": "object"
      },
      "ChatMessage": {
        "properties": {
          "content": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "CompletionRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "preferred_provider": {
            "anyOf": [
              {
                "enum": [
                  "groq",
                  "nim",
                  "gemini",
                  "openai"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Provider"
          }
        },
        "required": [
          "messages"
        ],
        "title": "CompletionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JSONRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "preferred_provider": {
            "anyOf": [
              {
                "enum": [
                  "groq",
                  "nim",
                  "gemini",
                  "openai"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Provider"
          },
          "schema_hint": {
            "additionalProperties": true,
            "title": "Schema Hint",
            "type": "object"
          }
        },
        "required": [
          "messages"
        ],
        "title": "JSONRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
