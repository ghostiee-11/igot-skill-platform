{
  "components": {
    "schemas": {
      "ActivityAnswer": {
        "properties": {
          "selected_option": {
            "title": "Selected Option",
            "type": "integer"
          }
        },
        "required": [
          "selected_option"
        ],
        "title": "ActivityAnswer",
        "type": "object"
      },
      "AssessmentCompleted": {
        "properties": {
          "attempt_id": {
            "title": "Attempt Id",
            "type": "string"
          },
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "score_percent": {
            "title": "Score Percent",
            "type": "number"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "event_id",
          "user_id",
          "course_id",
          "attempt_id",
          "score_percent",
          "passed",
          "occurred_at"
        ],
        "title": "AssessmentCompleted",
        "type": "object"
      },
      "Assignment": {
        "properties": {
          "course_id": {
            "title": "Course Id",
            "type": "integer"
          },
          "planned_for": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned For"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "user_id",
          "course_id"
        ],
        "title": "Assignment",
        "type": "object"
      },
      "CourseCreate": {
        "properties": {
          "category": {
            "default": "General",
            "title": "Category",
            "type": "string"
          },
          "difficulty": {
            "default": "intermediate",
            "title": "Difficulty",
            "type": "string"
          },
          "duration_hours": {
            "default": 4,
            "exclusiveMinimum": 0.0,
            "title": "Duration Hours",
            "type": "number"
          },
          "instructor": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Instructor",
            "type": "string"
          },
          "organization": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Organization",
            "type": "string"
          },
          "overview": {
            "minLength": 1,
            "title": "Overview",
            "type": "string"
          },
          "source": {
            "default": "internal",
            "title": "Source",
            "type": "string"
          },
          "title": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "overview",
          "instructor",
          "organization"
        ],
        "title": "CourseCreate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LearnerProjectionIn": {
        "properties": {
          "current_streak_days": {
            "default": 1,
            "title": "Current Streak Days",
            "type": "integer"
          },
          "daily_goal_minutes": {
            "default": 30,
            "title": "Daily Goal Minutes",
            "type": "integer"
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "designation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Designation"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "last_active_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Active Date"
          },
          "onboarding_completed": {
            "default": false,
            "title": "Onboarding Completed",
            "type": "boolean"
          },
          "role": {
            "default": "learner",
            "title": "Role",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "user_id",
          "email",
          "full_name"
        ],
        "title": "LearnerProjectionIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/v1/auth/login"
