{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igot.example/contracts/events/assessment-completed.v1.schema.json",
  "title": "Assessment completed",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "idempotency_key", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "assessment.completed"},
    "schema_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "assessment"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "assessment_id", "user_id", "engine", "score", "completed_at"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "assessment_id": {"type": "string", "minLength": 1},
        "user_id": {"type": "string", "minLength": 1},
        "engine": {"enum": ["statistical", "behavioural", "technical", "digital_governance"]},
        "score": {"type": "number"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
