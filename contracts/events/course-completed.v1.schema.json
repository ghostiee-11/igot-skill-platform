{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igot.example/contracts/events/course-completed.v1.schema.json",
  "title": "Course completed",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "idempotency_key", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "learning.course_completed"},
    "schema_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"const": "learning"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "course_id", "enrollment_id", "completed_at"],
      "properties": {
        "user_id": {"type": "string", "minLength": 1},
        "course_id": {"type": "string", "minLength": 1},
        "enrollment_id": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
