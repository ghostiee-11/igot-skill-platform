{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://igot.example/contracts/events/competency-evidence-recorded.v1.schema.json",
  "title": "Competency evidence recorded",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "producer", "idempotency_key", "data"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "competency.evidence_recorded"},
    "schema_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "user_id", "competency_code", "source_type", "source_id", "value", "recorded_at"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "user_id": {"type": "string", "minLength": 1},
        "competency_code": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["assessment", "learning", "lab", "manual"]},
        "source_id": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
